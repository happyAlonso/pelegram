diff --git a/protocol/wireguard/endpoint_connect_timeout_lx_test.go b/protocol/wireguard/endpoint_connect_timeout_lx_test.go
new file mode 100644
index 0000000..bcc7a89
--- /dev/null
+++ b/protocol/wireguard/endpoint_connect_timeout_lx_test.go
@@ -0,0 +1,60 @@
+package wireguard
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	N "github.com/sagernet/sing/common/network"
+)
+
+// A TCP connect through the tunnel must carry a deadline. Without one the gVisor dial retries
+// its own SYN schedule to exhaustion (~2m7s to a black-holed address), holding a goroutine, a
+// netstack endpoint and encrypted UDP retransmits on the radio long after the caller gave up.
+func TestDialDeadlineContextBoundsTCP(t *testing.T) {
+	t.Parallel()
+	ep := &Endpoint{connectTimeout: 10 * time.Second}
+	ctx, cancel := ep.dialDeadlineContext(context.Background(), N.NetworkTCP)
+	defer cancel()
+	deadline, ok := ctx.Deadline()
+	if !ok {
+		t.Fatal("expected a deadline on a TCP dial context")
+	}
+	if remaining := time.Until(deadline); remaining <= 0 || remaining > 10*time.Second {
+		t.Fatalf("deadline %v is not the configured 10s bound", remaining)
+	}
+}
+
+// A caller that set its own deadline knows better than the endpoint default.
+func TestDialDeadlineContextKeepsCallerDeadline(t *testing.T) {
+	t.Parallel()
+	ep := &Endpoint{connectTimeout: 10 * time.Second}
+	parent, parentCancel := context.WithTimeout(context.Background(), time.Second)
+	defer parentCancel()
+	ctx, cancel := ep.dialDeadlineContext(parent, N.NetworkTCP)
+	defer cancel()
+	deadline, ok := ctx.Deadline()
+	if !ok {
+		t.Fatal("expected the caller deadline to survive")
+	}
+	if remaining := time.Until(deadline); remaining > time.Second {
+		t.Fatalf("caller deadline was widened to %v", remaining)
+	}
+}
+
+// UDP has no connect to bound, and a zero timeout means the feature is off.
+func TestDialDeadlineContextLeavesUDPAndZeroAlone(t *testing.T) {
+	t.Parallel()
+	ep := &Endpoint{connectTimeout: 10 * time.Second}
+	ctx, cancel := ep.dialDeadlineContext(context.Background(), N.NetworkUDP)
+	defer cancel()
+	if _, ok := ctx.Deadline(); ok {
+		t.Fatal("UDP dial context must not get a connect deadline")
+	}
+	off := &Endpoint{}
+	ctx, cancel = off.dialDeadlineContext(context.Background(), N.NetworkTCP)
+	defer cancel()
+	if _, ok := ctx.Deadline(); ok {
+		t.Fatal("a zero connectTimeout must leave the context untouched")
+	}
+}
