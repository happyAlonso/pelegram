+// dialDeadlineContext bounds a TCP connect made through the tunnel.
+//
+// gVisor only consults the context while it is establishing the stream, and DialTCPWithBind
+// closes the endpoint on cancellation, so cancelling once the dial has returned cannot disturb
+// a connection that came up - the same contract net.Dialer documents. A caller that set its own
+// deadline keeps it; UDP has no connect and is left alone.
+func (w *Endpoint) dialDeadlineContext(ctx context.Context, network string) (context.Context, context.CancelFunc) {
+	if w.connectTimeout <= 0 || N.NetworkName(network) != N.NetworkTCP {
+		return ctx, func() {}
+	}
+	if _, hasDeadline := ctx.Deadline(); hasDeadline {
+		return ctx, func() {}
+	}
+	return context.WithTimeout(ctx, w.connectTimeout)
+}
